@using LBPUnion.ProjectLighthouse.Database
@using LBPUnion.ProjectLighthouse.Localization
@using LBPUnion.ProjectLighthouse.Servers.Website.Extensions
@using LBPUnion.ProjectLighthouse.Types.Activity
@using LBPUnion.ProjectLighthouse.Types.Entities.Activity
@using LBPUnion.ProjectLighthouse.Types.Entities.Profile
@inject DatabaseContext Database

@{
    string language = (string?)ViewData["Language"] ?? LocalizationManager.DefaultLang;
    string timeZone = (string?)ViewData["TimeZone"] ?? TimeZoneInfo.Local.Id;
    TimeZoneInfo timeZoneInfo = TimeZoneInfo.FindSystemTimeZoneById(timeZone);
}

<div class="ui blue segment" id="activity">
    @if (Model.Activity.Count == 0)
    {
        <p>There is no recent activity.</p>
    }
    else
    {
        <b>Recent activity</b>
        @foreach (IGrouping<ActivityGroup, ActivityDto> group in Model.Activity)
        {
            <div class="ui gray segment">
                @{
                    UserEntity user = await Database.Users.FindAsync(group.First().Activity.UserId) ?? throw new InvalidOperationException();
                }
                <span>@await user.ToLink(Html, ViewData, language)</span>
                <div class="list">
                    @foreach (ActivityDto activity in group)
                    {
                        <div class="item">
                            <i class="minus icon"></i>
                            @switch (activity.Activity.Type)
                            {
                                case EventType.PlayLevel: <span>played this level</span> break;
                                case EventType.HeartLevel: <span>hearted this level</span> break;
                                case EventType.UnheartLevel: <span>unhearted this level</span> break;
                                case EventType.Score:
                                    ScoreActivityEntity score = activity.Activity as ScoreActivityEntity ?? throw new InvalidOperationException();
                                    <span>scored @(score.Score.Points) points in @(score.Score.Type != 7 ? score.Score.Type + " player" : "versus") mode</span>
                                    break;
                                case EventType.PublishLevel: <span>published this level</span> break;
                                case EventType.RateLevel:
                                case EventType.DpadRateLevel:
                                    <span>rated this level</span>
                                    break;
                                case EventType.ReviewLevel: <span>reviewed this level</span> break;
                                case EventType.CommentOnLevel: <span>left a comment on this level</span> break;
                            }

                            <span> on <i>@TimeZoneInfo.ConvertTime(activity.Activity.Timestamp, timeZoneInfo).ToString("M/d/yyyy @ h:mm:ss tt")</i></span>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>